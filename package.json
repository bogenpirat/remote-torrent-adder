{
    "name": "remote-torrent-adder",
    "version": "2.3.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "test:e2e:chrome": "playwright test --config e2e/playwright.config.ts --project=chrome",
        "test:e2e:firefox": "playwright test --config e2e/playwright.config.ts --project=firefox",
        "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
        "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:firefox": "web-ext lint --source-dir dist/firefox",
        "audit": "node scripts/audit.mjs",
        "verify": "npm run typecheck && npm run lint && npm test",
        "prebuild": "npm run verify",
        "build": "npm run build:run",
        "build:run": "node scripts/build.mjs --browser=chrome",
        "prebuild:prod": "npm run verify",
        "build:prod": "npm run build:prod:run",
        "build:prod:run": "node scripts/build.mjs --browser=chrome --prod",
        "prebuild:firefox": "npm run verify",
        "build:firefox": "npm run build:firefox:run",
        "build:firefox:run": "node scripts/build.mjs --browser=firefox",
        "prebuild:firefox:prod": "npm run verify",
        "build:firefox:prod": "npm run build:firefox:prod:run",
        "build:firefox:prod:run": "node scripts/build.mjs --browser=firefox --prod",
        "prebuild:all": "npm run verify",
        "build:all": "npm run build:all:run",
        "build:all:run": "npm run build:run && npm run build:firefox:run && npm run build:prod:run && npm run build:firefox:prod:run",
        "clean": "rimraf dist",
        "clean:prod": "rimraf dist-prod",
        "dev": "npm run build:run && concurrently \"npm run watch:assets\" \"npm run watch:worker\" \"npm run watch:content-script\"",
        "dev:popup": "cross-env RTA_TARGET=popup vite",
        "dev:options": "cross-env RTA_TARGET=options vite",
        "dev:firefox": "npm run build:firefox:run && web-ext run --source-dir dist/firefox",
        "watch:assets": "chokidar \"src/assets/**\" src/manifest.json -c \"node scripts/build.mjs --only=assets\"",
        "watch:worker": "node scripts/build.mjs --only=worker --watch",
        "watch:content-script": "node scripts/build.mjs --only=content-script --watch"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.6",
        "@types/bencode": "^4.0.0",
        "@types/chrome": "^0.2.6",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/selenium-webdriver": "^4.35.6",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.10",
        "buffer": "^6.0.3",
        "chokidar-cli": "^3.0.0",
        "concurrently": "^10.0.5",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.11.0",
        "jsdom": "^30.0.1",
        "postcss": "^8.5.26",
        "rimraf": "^6.1.3",
        "selenium-webdriver": "^4.48.0",
        "tailwindcss": "^4.3.1",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.9",
        "web-ext": "^10.6.0"
    },
    "dependencies": {
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-slot": "^1.3.0",
        "bencode": "^4.0.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.33.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwind-merge": "^3.6.0"
    }
}
