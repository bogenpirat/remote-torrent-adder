{
    "name": "remote-torrent-adder",
    "version": "2.4.2",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "test:e2e:chrome": "playwright test --config e2e/playwright.config.ts --project=chrome",
        "test:e2e:firefox": "playwright test --config e2e/playwright.config.ts --project=firefox",
        "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
        "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
        "test:it": "playwright test --config test/it/playwright.config.ts --workers=100%",
        "test:it:headed": "playwright test --config test/it/playwright.config.ts --headed",
        "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:firefox": "web-ext lint --source-dir dist/firefox",
        "lint:firefox:unlisted": "web-ext lint --source-dir dist-prod/firefox-unlisted --self-hosted",
        "audit": "node scripts/audit.ts",
        "verify": "npm run typecheck && npm run lint && npm test",
        "prebuild": "npm run verify",
        "build": "npm run build:run",
        "build:run": "node scripts/build.ts --browser=chrome",
        "prebuild:prod": "npm run verify",
        "build:prod": "npm run build:prod:run",
        "build:prod:run": "node scripts/build.ts --browser=chrome --prod",
        "prebuild:firefox": "npm run verify",
        "build:firefox": "npm run build:firefox:run",
        "build:firefox:run": "node scripts/build.ts --browser=firefox",
        "prebuild:firefox:prod": "npm run verify",
        "build:firefox:prod": "npm run build:firefox:prod:run",
        "build:firefox:prod:run": "node scripts/build.ts --browser=firefox --prod",
        "build:firefox:unlisted:run": "node scripts/build-unlisted.ts",
        "prebuild:all": "npm run verify",
        "build:all": "npm run build:all:run",
        "build:all:run": "npm run build:run && npm run build:firefox:run && npm run build:prod:run && npm run build:firefox:prod:run && npm run build:firefox:unlisted:run",
        "clean": "rimraf dist",
        "clean:prod": "rimraf dist-prod",
        "dev": "npm run build:run && concurrently \"npm run watch:assets\" \"npm run watch:worker\" \"npm run watch:content-script\"",
        "dev:popup": "cross-env RTA_TARGET=popup vite",
        "dev:options": "cross-env RTA_TARGET=options vite",
        "dev:firefox": "npm run build:firefox:run && web-ext run --source-dir dist/firefox",
        "watch:assets": "node scripts/build.ts --only=assets --watch",
        "watch:worker": "node scripts/build.ts --only=worker --watch",
        "watch:content-script": "node scripts/build.ts --only=content-script --watch"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "^4.3.4",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/bencode": "^4.0.0",
        "@types/chrome": "^0.3.7",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/selenium-webdriver": "^4.35.7",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitest/coverage-v8": "^5.1.0",
        "concurrently": "^10.0.6",
        "cross-env": "^10.1.0",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fake-indexeddb": "^6.2.7",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "rimraf": "^6.1.4",
        "selenium-webdriver": "^4.52.0",
        "tailwindcss": "^4.3.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0",
        "web-ext": "^10.8.0"
    },
    "dependencies": {
        "bencode": "^4.0.1",
        "clsx": "^2.1.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0"
    },
    "overrides": {
        "fx-runner": {
            "shell-quote": "1.12.0"
        }
    }
}
