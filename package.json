{
    "name": "remote-torrent-adder",
    "version": "2.2.0",
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "test:e2e:headed": "playwright test --config e2e/playwright.config.ts --headed",
        "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prebuild": "npm run typecheck && npm run lint && npm test",
        "prebuild:prod": "npm run typecheck && npm run lint && npm test",
        "build": "npm run build:run",
        "build:run": "npm run clean && npm run copy-assets && npm run build:targets",
        "build:targets": "npm run build:worker && npm run build:content-script && npm run build:popup && npm run build:options && npm run build:notifications",
        "build:worker": "cross-env RTA_TARGET=worker vite build",
        "build:content-script": "cross-env RTA_TARGET=content-script vite build",
        "build:popup": "cross-env RTA_TARGET=popup vite build",
        "build:options": "cross-env RTA_TARGET=options vite build",
        "build:notifications": "cross-env RTA_TARGET=notifications vite build",
        "dev:popup": "cross-env RTA_TARGET=popup vite",
        "dev:options": "cross-env RTA_TARGET=options vite",
        "build:prod": "npm run build:prod:run",
        "build:prod:run": "npm run clean:prod && npm run copy-assets:prod && cross-env PROD=true npm run build:targets",
        "clean": "rimraf dist",
        "clean:prod": "rimraf dist-prod",
        "copy": "cpy 'src/**' dist --parents",
        "copy:prod": "cpy 'src/**' dist-prod --parents",
        "copy-assets": "cpy 'src/**/*.{json,html,css,png,svg,ogg}' dist --parents",
        "copy-assets:prod": "cpy 'src/**/*.{json,html,css,png,svg,ogg}' dist-prod --parents",
        "watch:assets": "chokidar 'src/**/*.{json,html,css,png,svg,ogg}' -c 'npm run copy-assets'",
        "watch:worker": "cross-env RTA_TARGET=worker vite build --watch",
        "watch:content-script": "cross-env RTA_TARGET=content-script vite build --watch",
        "dev": "npm run build && concurrently \"npm run watch:assets\" \"npm run watch:worker\" \"npm run watch:content-script\""
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.62.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.3",
        "@types/bencode": "^4.0.0",
        "@types/chrome": "^0.2.6",
        "@types/node": "^26.2.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-v8": "^4.1.10",
        "buffer": "^6.0.3",
        "chokidar-cli": "^3.0.0",
        "concurrently": "^10.0.5",
        "cpy-cli": "^7.0.0",
        "cross-env": "^10.1.0",
        "eslint": "^10.8.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.9.0",
        "jsdom": "^30.0.1",
        "postcss": "^8.5.26",
        "rimraf": "^6.1.3",
        "tailwindcss": "^4.3.1",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.1",
        "vitest": "^4.1.9"
    },
    "dependencies": {
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-slot": "^1.3.0",
        "bencode": "^4.0.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.31.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "tailwind-merge": "^3.6.0"
    }
}
