{
    "name": "remote-torrent-adder",
    "version": "2.4.2",
    "type": "module",
    "packageManager": "pnpm@12.18.0",
    "engines": {
        "node": ">=26"
    },
    "scripts": {
        "test": "vitest run",
        "test:e2e": "playwright test --config e2e/playwright.config.ts",
        "test:it": "playwright test --config test/it/playwright.config.ts --workers=100%",
        "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
        "lint": "eslint .",
        "lint:firefox": "web-ext lint --source-dir dist/firefox",
        "verify": "pnpm typecheck && pnpm lint && pnpm test",
        "bundle": "node scripts/build.ts",
        "build": "pnpm verify && pnpm bundle",
        "dev": "node scripts/build.ts --watch",
        "dev:firefox": "pnpm bundle --browser=firefox && web-ext run --source-dir dist/firefox",
        "clean": "rimraf dist dist-prod"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.65.0",
        "@tailwindcss/vite": "^4.3.4",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/bencode": "^4.0.0",
        "@types/chrome": "^0.3.7",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/selenium-webdriver": "^4.35.7",
        "@vitejs/plugin-react": "^6.2.1",
        "@vitest/coverage-v8": "^5.1.0",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fake-indexeddb": "^6.2.7",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
        "rimraf": "^6.1.4",
        "selenium-webdriver": "^4.52.0",
        "tailwindcss": "^4.3.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.6",
        "vitest": "^5.1.0",
        "web-ext": "^10.8.0"
    },
    "dependencies": {
        "bencode": "^4.0.1",
        "clsx": "^2.1.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0"
    }
}
